<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Balancio.Views.Popups.SheetListPopup"
    x:TypeArguments="x:Object"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:Balancio.Models">

    <Border
        BackgroundColor="#1A1A20"
        StrokeThickness="0"
        Padding="20"
        WidthRequest="300">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="16">

            <Label
                Text="Connected Spreadsheets"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#FFFFFF" />

            <CollectionView
                x:Name="ConnectionsList"
                SelectionMode="None"
                HeightRequest="200">

                <CollectionView.EmptyView>
                    <Label
                        Text="No spreadsheets saved yet."
                        FontSize="13"
                        TextColor="#8A8A93"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SheetConnection">
                        <Border
                            BackgroundColor="#25252C"
                            Stroke="{Binding IsCurrent, Converter={StaticResource CurrentBorderColorConverter}}"
                            StrokeThickness="{Binding IsCurrent, Converter={StaticResource CurrentBorderWidthConverter}}"
                            Padding="14,12"
                            Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnConnectionTapped"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        Text="{Binding Alias}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#F2F2F5" />
                                    <Label
                                        Text="{Binding Url}"
                                        FontSize="11"
                                        TextColor="#8A8A93"
                                        LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="✕"
                                    FontSize="14"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    Padding="0"
                                    CornerRadius="17"
                                    BackgroundColor="#3A2530"
                                    TextColor="#FF5C7A"
                                    VerticalOptions="Center"
                                    Clicked="OnDeleteClicked"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="+ Add New Spreadsheet"
                BackgroundColor="#FF7A45"
                TextColor="#FFFFFF"
                CornerRadius="12"
                Clicked="OnAddNewClicked" />

            <Button
                Text="Cancel"
                BackgroundColor="Transparent"
                TextColor="#8A8A93"
                Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>